{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "confluco-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],

  // Serves the API and the sign-in page (Clerk Sync Host). The zone must be on the deploying account.
  "routes": [{ "pattern": "confluco-api.cofun.cc", "custom_domain": true }],
  "workers_dev": false,

  // Workers Logs: keep console output and per-request invocation logs in the dashboard.
  "observability": {
    "logs": { "enabled": true, "invocation_logs": true },
  },

  // Workers AI: models run on Cloudflare, no external API keys.
  "ai": { "binding": "AI" },

  // Per-user daily request counters, one Durable Object per Clerk user id.
  "durable_objects": { "bindings": [{ "name": "QUOTA", "class_name": "UserQuota" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserQuota"] }],

  // Per-request usage records (sizes, token counts, outcome; never message content).
  // Workers Analytics Engine keeps them for 90 days. The dataset is created on first write.
  "analytics_engine_datasets": [{ "binding": "USAGE", "dataset": "confluco_api_usage" }],

  "vars": {
    // Clerk publishable key, for the sign-in page. Public. The Cofun products share one Clerk
    // application (Frontend API clerk.cofun.cc), so one account signs in to all of them.
    "CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsuY29mdW4uY2Mk",
    // AI Gateway id (dashboard: AI > AI Gateway). Empty = call Workers AI directly. The gateway is
    // shared by the Cofun products; requests are tagged with metadata.app.
    "AI_GATEWAY_ID": "cofun-ai-gateway",
    // The only model clients can use.
    "MODEL": "@cf/deepseek-ai/deepseek-v4.1-flash-1017",
    // Chat requests each user may make per UTC day.
    "DAILY_REQUEST_LIMIT": "100",
    // Origins allowed to call (the token's azp claim). Comma-separated.
    "CLERK_AUTHORIZED_PARTIES": "chrome-extension://fccfdaiibgaiblpkkmpfgoijmokbgfng,https://confluco-api.cofun.cc",
    // Clerk JWT public key (PEM). Public; also served at https://<frontend-api>/.well-known/jwks.json
    "CLERK_JWT_KEY": "-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAvmcyRgQuBYHuMrpM4d5N\nwQ9Y7i59S80hLM7Qd68gIpszm0Mi7eOIMmxTOVIePX4jsjf+ByfPl6qluXsPGik/\nwtr1ti37UUADTdC1qjn3jabY22UebFXgxp6Fq6XHJKelmHQBm77OwzZMPzPgmnwK\nM9nJuxXpsGtNH3a8xzC8Ql8UOJE5eWvgXKcu48b/Awja7J+yGQe7OklbaJL71FrJ\nPGUDS7bLVHvJP8/xTd3eii+LdqN5o7RDqwDu1wesJ9g2f8ykLfd55ykVZURr8R3w\n6Z46/wXqoufUn4CdRwsY19zNQlhruUMSGsRLn9PiYOfL1aBHZZzR/tLRndIFq9lY\nqQIDAQAB\n-----END PUBLIC KEY-----\n",
  },
}
